# AI Services Environment Variables Template
# Copy this to .env in each AI service directory (chatbot, pill-identification, fall-detection)

# CORS Configuration - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini API Key (required for chatbot service only)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision API (required for pill-identification service only)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
